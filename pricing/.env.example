# Pricing Engine — локальная разработка
# Скопируйте в .env.local и измените под себя

HTTP_PORT=8081
LOG_LEVEL=debug
LOG_FORMAT=text
ENVIRONMENT=dev

# Выбор бэкенда: file или postgres
STORE_BACKEND=file

# Для STORE_BACKEND=file
PRICES_FILE_PATH=./prices/prices.json

# Для STORE_BACKEND=postgres (раскомментируйте)
# DATABASE_URL=postgres://pricer:pricer@localhost:5432/pricer?sslmode=disable

