# ── Бинарники ────────────────────────────────────────────────────
.bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# ── Рабочие файлы make run ───────────────────────────────────────
# PID файлы запущенных процессов
.pids/

# Логи локального запуска
.logs/

# ── Go ───────────────────────────────────────────────────────────
# Кэш тестов и сборки
vendor/

# go workspace sum (генерируется автоматически)
go.work.sum

# ── Переменные окружения ─────────────────────────────────────────
# Локальные конфиги с секретами — не коммитим
.env
.env.local
.env.*.local

# Примеры env файлов коммитим — они без реальных секретов
!.env.example

# ── БД и данные ──────────────────────────────────────────────────
# Локальные данные PostgreSQL если вдруг запускается без Docker
*.db
*.sqlite
*.sqlite3
pgdata/

# ── IDE и редакторы ──────────────────────────────────────────────
# JetBrains (GoLand, IntelliJ)
.idea/
*.iml

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# Vim / Neovim
*.swp
*.swo
*~
.netrwhist

# macOS
.DS_Store
.AppleDouble
.LSOverride

# ── OS ───────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Docker ───────────────────────────────────────────────────────
# Локальные override файлы
docker-compose.override.yml
docker-compose.local.yml

# ── Тесты и покрытие ─────────────────────────────────────────────
*.test
coverage.out
coverage.html
